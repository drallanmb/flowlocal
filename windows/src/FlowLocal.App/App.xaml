<Application x:Class="FlowLocal.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Brushes are replaced at startup to follow the system light/dark theme (see Theme.cs). -->
        <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#F6F6F7"/>
        <SolidColorBrush x:Key="FgBrush" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6E6E73"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#A1A1A6"/>
        <SolidColorBrush x:Key="CardBrush" Color="#F2F2F4"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E5E5EA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5E5CE6"/>
        <SolidColorBrush x:Key="SelectBrush" Color="#E8E8EC"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Faint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="MinWidth" Value="180"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource FgBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Application.Resources>
</Application>
